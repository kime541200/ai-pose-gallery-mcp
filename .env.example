# MCP Server 對外發布的埠號
PORT=8090

# ai-pose-gallery-zh 後端服務位址（請依實際佈署的主機與 Port 修改）
# 若在同一台機器以 Docker 執行，可用 http://host.docker.internal:<PORT>
GALLERY_URL=http://host.docker.internal:8080

# 選填：回傳給使用者瀏覽器點擊的圖庫公開網址
# 若留空，會自動將 GALLERY_URL 中的 host.docker.internal 替換為 127.0.0.1（保留設定的 Port）
GALLERY_PUBLIC_URL=

# ComfyUI 服務位址（請依實際佈署的主機與 Port 修改）
COMFYUI_URL=http://host.docker.internal:8188

# 選填：回傳給使用者瀏覽器預覽生成圖的 ComfyUI 公開網址
# 若留空，會自動將 COMFYUI_URL 中的 host.docker.internal 替換為 127.0.0.1（保留設定的 Port）
COMFYUI_PUBLIC_URL=

# 選填：匯出 ComfyUI API Workflow JSON 的宿主機目錄（預設為本專案下的 ./tmp）
WORKFLOW_HOST_DIR=./tmp
